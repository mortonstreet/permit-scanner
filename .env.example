# ── Permit sources ───────────────────────────────────────────────────────────
# Every Florida/Texas/metro source in the registry is free and keyless.
# Nothing below is required to run the app.

# Raises Socrata's anonymous rate limit. Free: https://evergreen.data.socrata.com/signup
SOCRATA_APP_TOKEN=

# National normalized backfill. Free tier = 500 records / rolling 30 days.
# NOTE: median ingestion lag is ~84 days, so this is breadth, not fresh signal.
# https://app.shovels.ai/create-account/
SHOVELS_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Optional. Without it the app runs fully against live sources, but nothing is
# retained and the enrichment cache is per-process.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact enrichment (all optional) ────────────────────────────────────────
# Waterfall order is cheapest-first: the permit's own contact (free) ->
# Shovels employees -> ContactOut -> RocketReach.
#
# ⚠ BEFORE USING THESE COMMERCIALLY: RocketReach and ContactOut both prohibit
#   reselling their contact data in their standard terms. See README.
CONTACTOUT_API_KEY=
ROCKETREACH_API_KEY=

# ── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_WORD=permit
NEXT_PUBLIC_BRAND_ACCENT=stack
NEXT_PUBLIC_BRAND_DOMAIN=permit-stack.com
