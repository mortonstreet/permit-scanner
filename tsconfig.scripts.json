{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["worker/**/*.ts", "scripts/**/*.ts", "lib/**/*.ts"]
}
